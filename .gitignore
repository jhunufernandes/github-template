# Generic ignores shared by every repository.
# Language-specific templates (e.g. python-package-template) append their own rules below.

# --- OS ---
.DS_Store
Thumbs.db

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*~

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs / temp ---
*.log
tmp/
